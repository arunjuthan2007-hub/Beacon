{
  "manifest_version": 3,
  "name": "Beacon",
  "version": "1.0.0",
  "description": "Plain-English guidance for Terms, Privacy Policies, Consent screens, and Cookie notices.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Beacon"
  },
  "permissions": ["tabs", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}